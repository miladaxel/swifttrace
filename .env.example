# Copy to .env for the production Compose deployment and fill the required values.
DJANGO_SECRET_KEY=
# Example: example.com,www.example.com
DJANGO_ALLOWED_HOSTS=
# Example: https://example.com,https://www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
DB_PASSWORD=
# Use only with a trusted HTTPS reverse proxy that replaces client X-Forwarded-Proto.
DJANGO_TRUST_X_FORWARDED_PROTO=true
# Set after HTTPS is working for every hostname.
DJANGO_HSTS_SECONDS=0
# Login POSTs are limited to 20 per IP per 15 minutes by default.
# For deployments outside compose.prod.yaml, set LOGIN_TRUSTED_PROXY_IPS
# and WIRE_TRUSTED_PROXY_IPS to the exact IP address of your trusted reverse proxy.
LOGIN_RATE_LIMIT=20
LOGIN_RATE_WINDOW_SECONDS=900
# Each signed-in account can submit 30 searches in any 60-minute period.
ACCOUNT_SEARCH_RATE_LIMIT=30
ACCOUNT_SEARCH_WINDOW_SECONDS=3600
# Each successful search grants up to 30 result-page views during its access window.
WIRE_RESULT_VIEW_LIMIT=30
